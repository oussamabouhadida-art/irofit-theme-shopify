<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-scheme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}

    <title>{{ shop.name }} — {{ 'general.password_page.opening_soon' | t }}</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <style>
      :root {
        --color-ink: {{ settings.color_ink }};
        --color-cream: {{ settings.color_cream }};
        --color-forest: {{ settings.color_forest }};
        --color-ash: {{ settings.color_ash }};
        --bg: var(--color-ink);
        --fg: var(--color-cream);
        --easing: cubic-bezier(0.22, 1, 0.36, 1);
      }
      body.password-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
      }
      .password-page__main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1.5rem;
      }
      .password-page__inner {
        max-width: 540px;
        text-align: center;
      }
      .password-page__eyebrow {
        font-family: 'Inter', sans-serif;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.42em;
        color: rgba(245, 240, 235, 0.45);
        margin-bottom: 3rem;
      }
      .password-page__wordmark {
        font-family: 'EB Garamond', serif;
        font-size: clamp(3rem, 8vw, 5rem);
        letter-spacing: 0.02em;
        margin-bottom: 2rem;
        font-weight: 400;
      }
      .password-page__wordmark em { font-weight: 300; }
      .password-page__tagline {
        font-family: 'EB Garamond', serif;
        font-style: italic;
        font-size: clamp(1.25rem, 2.5vw, 1.75rem);
        color: rgba(245, 240, 235, 0.8);
        margin-bottom: 3rem;
        line-height: 1.4;
      }
      .password-page__meta {
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: rgba(245, 240, 235, 0.55);
        margin-bottom: 3rem;
      }
      .password-page__form { margin-bottom: 3rem; }
      .password-page__form-row {
        display: flex;
        gap: 0.5rem;
        max-width: 420px;
        margin: 0 auto;
        flex-wrap: wrap;
        justify-content: center;
      }
      .password-page__input {
        flex: 1;
        min-width: 220px;
        background: transparent;
        border: 0;
        border-bottom: 1px solid rgba(245, 240, 235, 0.25);
        color: var(--fg);
        padding: 0.75rem 0;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        outline: none;
        transition: border-color var(--motion-micro, 500ms) var(--easing);
      }
      .password-page__input:focus { border-color: var(--fg); }
      .password-page__submit {
        background: transparent;
        border: 1px solid rgba(245, 240, 235, 0.3);
        color: var(--fg);
        padding: 0.75rem 1.5rem;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: all 500ms var(--easing);
      }
      .password-page__submit:hover {
        background: var(--fg);
        color: var(--bg);
      }
      .password-page__login {
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: rgba(245, 240, 235, 0.55);
        text-decoration: none;
        transition: color 500ms var(--easing);
      }
      .password-page__login:hover { color: var(--fg); }
      .password-page__footer {
        padding: 1.5rem;
        text-align: center;
        font-family: 'Inter', sans-serif;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.3em;
        color: rgba(245, 240, 235, 0.45);
      }
      .password-page__footer em {
        font-family: 'EB Garamond', serif;
        font-style: italic;
        text-transform: none;
        letter-spacing: 0.02em;
        font-size: 14px;
      }
    </style>
  </head>
  <body class="password-page">
    <main class="password-page__main">
      <div class="password-page__inner">
        <div class="password-page__eyebrow">{{ shop.name | upcase }} — ARRIVING OCTOBER 2026</div>

        <h1 class="password-page__wordmark">
          IRO<em>fit</em>
        </h1>

        <p class="password-page__tagline"><em>Her Flow. His Fire. Their Joy.</em></p>

        <p class="password-page__meta">{{ 'general.password_page.opening_soon' | t }}</p>

        <div class="password-page__form">
          {% form 'storefront_password' %}
            <div class="password-page__form-row">
              <input
                type="password"
                name="password"
                class="password-page__input"
                placeholder="{{ 'general.password_page.password_placeholder' | t }}"
                aria-label="{{ 'general.password_page.password_placeholder' | t }}"
                required>
              <button type="submit" class="password-page__submit">{{ 'general.password_page.submit' | t }} →</button>
            </div>
            {{ form.errors | default_errors }}
          {% endform %}
        </div>

        {{ content_for_layout }}

        <a href="/admin" class="password-page__login">{{ 'general.password_page.admin_login' | t }} →</a>
      </div>
    </main>

    <footer class="password-page__footer">
      © {{ 'now' | date: '%Y' }} {{ shop.name }} · <em>Three Beats. One Rhythm.</em> · team@irofit.fr
    </footer>
  </body>
</html>
