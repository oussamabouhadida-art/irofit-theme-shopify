{%- liquid
  comment
    Usage: {% render 'color-swatch', value: 'Cream', size: 14, klass: 'product-card__swatch' %}
  endcomment

  assign v = value | downcase | strip
  assign hex = '#807468'
  case v
    when 'cream' then assign hex = '#F5F0EB'
    when 'cream 2' then assign hex = '#EFE7DE'
    when 'forest' then assign hex = '#2D4132'
    when 'ash' then assign hex = '#807468'
    when 'charcoal' then assign hex = '#3A332C'
    when 'ink' then assign hex = '#1A1612'
    when 'black' then assign hex = '#1A1612'
    when 'white' then assign hex = '#F5F0EB'
  endcase
  assign px = size | default: 14
  assign cls = klass | default: 'product-card__swatch'
-%}
<span class="{{ cls }}" style="background:{{ hex }};width:{{ px }}px;height:{{ px }}px;" title="{{ value | escape }}" aria-label="{{ value | escape }}"></span>
