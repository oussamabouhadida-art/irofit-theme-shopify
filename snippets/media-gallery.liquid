{%- liquid
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
-%}
<div class="media-gallery" data-media-gallery>
  <div class="media-gallery__main aspect-portrait">
    {%- if featured -%}
      {%- case featured.media_type -%}
        {%- when 'image' -%}
          <img
            src="{{ featured | image_url: width: 1200 }}"
            srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 900 }} 900w, {{ featured | image_url: width: 1200 }} 1200w, {{ featured | image_url: width: 1800 }} 1800w"
            sizes="(min-width: 1024px) 55vw, 100vw"
            alt="{{ featured.alt | escape }}"
            width="1200"
            height="1600"
            loading="eager">
        {%- when 'video' -%}
          {{ featured | video_tag: image_size: '1200x', autoplay: false, muted: true, controls: true, loop: false }}
        {%- when 'external_video' -%}
          {{ featured | external_video_tag }}
        {%- when 'model' -%}
          {{ featured | model_viewer_tag: image_size: '1200x', toggleable: true }}
      {%- endcase -%}
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="media-gallery__thumbs" role="tablist" aria-label="{{ 'products.product.media_gallery' | t }}">
      {%- for media in product.media -%}
        <button
          type="button"
          role="tab"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          data-src="{{ media | image_url: width: 1200 }}"
          data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
          class="media-gallery__thumb">
          <img
            src="{{ media | image_url: width: 200 }}"
            alt=""
            width="100"
            height="133"
            loading="lazy">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
