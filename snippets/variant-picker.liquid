{%- liquid
  assign product_json = product | json
-%}

<div class="variant-picker" data-variant-picker data-product='{{ product_json | escape }}'>
  {%- for option in product.options_with_values -%}
    {%- assign downcase_name = option.name | downcase -%}
    {%- assign is_color = false -%}
    {%- if downcase_name contains 'color' or downcase_name contains 'colour' or downcase_name contains 'couleur' -%}
      {%- assign is_color = true -%}
    {%- endif -%}
    <div class="product__variant-group" data-option-group data-option-name="{{ option.name | escape }}">
      <div class="product__variant-label">
        {{ option.name }}<span class="muted" data-current-option> · {{ option.selected_value }}</span>
      </div>
      {%- if is_color -%}
        <div class="variant-swatches" role="radiogroup" aria-label="{{ option.name }}">
          {%- for value in option.values -%}
            {%- assign checked = false -%}
            {%- if option.selected_value == value -%}{%- assign checked = true -%}{%- endif -%}
            {%- liquid
              assign vlow = value | downcase | strip
              assign hex = '#807468'
              case vlow
                when 'cream' then assign hex = '#F5F0EB'
                when 'cream 2' then assign hex = '#EFE7DE'
                when 'forest' then assign hex = '#2D4132'
                when 'ash' then assign hex = '#807468'
                when 'charcoal' then assign hex = '#3A332C'
                when 'ink' then assign hex = '#1A1612'
                when 'black' then assign hex = '#1A1612'
                when 'white' then assign hex = '#F5F0EB'
              endcase
            -%}
            <button
              type="button"
              class="variant-swatch"
              data-option-value
              data-value="{{ value | escape }}"
              role="radio"
              aria-checked="{{ checked }}"
              aria-label="{{ option.name }}: {{ value }}"
              title="{{ value }}"
              style="background:{{ hex }};">
            </button>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="variant-sizes" role="radiogroup" aria-label="{{ option.name }}">
          {%- for value in option.values -%}
            {%- assign checked = false -%}
            {%- if option.selected_value == value -%}{%- assign checked = true -%}{%- endif -%}
            <button
              type="button"
              class="variant-size"
              data-option-value
              data-value="{{ value | escape }}"
              role="radio"
              aria-checked="{{ checked }}">
              {{ value }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
