<section class="container section" style="max-width:540px;">
  <h1 class="account__title" style="margin-bottom:2rem;">{{ 'customer.register.title' | t }}</h1>

  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <div class="field" style="margin-bottom:1.5rem;">
      <label class="field__label" for="first_name">{{ 'customer.register.first_name' | t }}</label>
      <input type="text" id="first_name" name="customer[first_name]" class="input" autocomplete="given-name">
    </div>
    <div class="field" style="margin-bottom:1.5rem;">
      <label class="field__label" for="last_name">{{ 'customer.register.last_name' | t }}</label>
      <input type="text" id="last_name" name="customer[last_name]" class="input" autocomplete="family-name">
    </div>
    <div class="field" style="margin-bottom:1.5rem;">
      <label class="field__label" for="email">{{ 'customer.register.email' | t }}</label>
      <input type="email" id="email" name="customer[email]" required class="input" autocomplete="email">
    </div>
    <div class="field" style="margin-bottom:2rem;">
      <label class="field__label" for="password">{{ 'customer.register.password' | t }}</label>
      <input type="password" id="password" name="customer[password]" required class="input" autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn--filled btn--block">{{ 'customer.register.submit' | t }} →</button>
  {% endform %}
</section>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
