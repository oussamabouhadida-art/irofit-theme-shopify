<section class="container section">
  <div class="account">
    <header class="account__head">
      <p class="text-meta" style="margin-bottom:1rem;">ACCOUNT — {{ customer.email }}</p>
      <h1 class="account__title">{{ 'customer.account.title' | t }}</h1>
      <p class="muted">{{ 'customer.account.welcome' | t: name: customer.first_name }}</p>
    </header>

    <section class="account__section">
      <h3>{{ 'customer.orders.title' | t }}</h3>
      {%- if customer.orders.size > 0 -%}
        <table class="account__orders">
          <thead>
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th style="text-align:right;">{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a href="{{ order.customer_url }}" class="link-inline">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td style="text-align:right;">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p class="muted">{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </section>

    <section class="account__section">
      <h3>{{ 'customer.addresses.title' | t }}</h3>
      {%- if customer.default_address -%}
        <address style="font-style:normal;line-height:1.7;">
          {{ customer.default_address | format_address }}
        </address>
      {%- endif -%}
      <p style="margin-top:1.5rem;">
        <a href="{{ routes.account_addresses_url }}" class="link-inline">{{ 'customer.addresses.manage' | t }} →</a>
      </p>
    </section>

    <p>
      <a href="{{ routes.account_logout_url }}" class="link-inline">{{ 'customer.account.logout' | t }} →</a>
    </p>
  </div>
</section>

{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
