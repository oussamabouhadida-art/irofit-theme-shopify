<section class="section">
  <div class="container">
    <header style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-animate>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 data-animate style="--animate-delay:80ms;">{{ section.settings.heading }}</h2>
    </header>

    {%- if section.settings.image != blank -%}
      <div class="lookbook" data-animate>
        <div class="lookbook__image">
          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="2000"
            height="1300"
            loading="lazy">

          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              {%- assign hot_product = all_products[block.settings.product] -%}
              <button
                class="lookbook__hotspot"
                data-hotspot
                aria-expanded="false"
                aria-controls="popup-{{ block.id }}"
                style="top:{{ block.settings.y }}%;left:{{ block.settings.x }}%;"
                {{ block.shopify_attributes }}>
                +
              </button>
              <div id="popup-{{ block.id }}" class="lookbook__popup"
                   style="top:calc({{ block.settings.y }}% + 36px);left:{{ block.settings.x }}%;">
                <a href="{{ hot_product.url }}" style="display:flex;gap:0.75rem;align-items:center;">
                  {%- if hot_product.featured_media -%}
                    <img src="{{ hot_product.featured_media | image_url: width: 120 }}" alt="" width="60" height="80" loading="lazy">
                  {%- endif -%}
                  <div>
                    <h4 style="font-family:var(--font-display);font-size:14px;margin-bottom:0.25rem;">{{ hot_product.title }}</h4>
                    <span class="text-meta">{{ hot_product.price | money }}</span>
                  </div>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EDITORIAL — SHOPPABLE" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>The look, <em>tapped</em>.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "X position", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Y position", "default": 50 }
      ]
    }
  ],
  "presets": [
    { "name": "Lookbook", "category": "Editorial" }
  ]
}
{% endschema %}
