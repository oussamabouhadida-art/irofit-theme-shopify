{% render 'breadcrumb' %}

<section class="container section">
  <div class="product">
    <div class="product__media" data-sticky-atc-trigger>
      {% render 'media-gallery', product: product %}
    </div>

    <div class="product__info">
      {%- if product.vendor != blank -%}
        <p class="text-meta">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="product__title" data-animate>{{ product.title }}</h1>

      <div class="product__price" data-animate style="--animate-delay:80ms;">
        {% render 'price', product: product, use_variant: true %}
      </div>

      {%- if product.description != blank -%}
        <div class="product__description" data-animate style="--animate-delay:160ms;">
          {{ product.description }}
        </div>
      {%- endif -%}

      <form method="post" action="{{ routes.cart_add_url }}" data-animate style="--animate-delay:240ms;">
        {% render 'variant-picker', product: product %}

        <div class="product__atc-row" style="margin-top:2rem;">
          <div class="qty">
            <button type="button" data-qty="-1" aria-label="Decrease">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
            <button type="button" data-qty="1" aria-label="Increase">+</button>
          </div>
          <button type="submit" class="btn btn--filled" data-atc-btn style="flex:1;">
            <span data-atc-label>{{ 'products.product.add_to_cart' | t }}</span> →
          </button>
        </div>

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      </form>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'meta' -%}
            <details class="account__section" {{ block.shopify_attributes }} style="padding:1rem 0;border-top:var(--hairline);">
              <summary style="cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
                <span class="text-meta">{{ block.settings.heading }}</span>
                <span aria-hidden="true">+</span>
              </summary>
              <div style="padding-top:1rem;color:rgba(245,240,235,0.75);font-size:14px;line-height:1.7;">
                {{ block.settings.content }}
              </div>
            </details>
          {%- when 'share' -%}
            <div style="margin-top:1.5rem;display:flex;gap:1rem;" {{ block.shopify_attributes }}>
              {%- assign share_url = shop.url | append: product.url -%}
              <a class="text-meta" href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener">Share ↗</a>
              <a class="text-meta" href="https://x.com/intent/tweet?url={{ share_url | url_encode }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener">Tweet ↗</a>
              <a class="text-meta" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ product.featured_media | image_url: width: 1200 | url_encode }}" target="_blank" rel="noopener">Pin ↗</a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.show_related -%}
  {%- assign related = recommendations.products | default: collections.all.products -%}
  {%- if related.size > 0 -%}
    <section class="section" style="border-top:var(--hairline);">
      <div class="container">
        <header style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
          <p class="eyebrow">YOU MAY — ALSO LIKE</p>
          <h2 data-animate>Quiet <em>essentials</em>.</h2>
        </header>
        <div class="product-grid">
          {%- for rel in related limit: 4 -%}
            {%- if rel.id != product.id -%}
              {% render 'product-card', product: rel %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

<aside class="product__sticky" data-sticky-atc aria-hidden="true">
  <div>
    <strong style="font-family:var(--font-display);font-size:1rem;display:block;">{{ product.title }}</strong>
    <span class="text-meta">{{ product.price | money }}</span>
  </div>
  <a href="#MainContent" class="btn btn--filled" data-cart-open style="flex-shrink:0;">{{ 'products.product.add_to_cart' | t }} →</a>
</aside>

{% render 'json-ld-product', product: product %}

<script>
  // Qty stepper
  document.querySelectorAll('.qty').forEach(function (q) {
    var input = q.querySelector('input');
    q.querySelectorAll('button[data-qty]').forEach(function (b) {
      b.addEventListener('click', function () {
        var delta = parseInt(b.dataset.qty, 10);
        var next = Math.max(1, parseInt(input.value, 10) + delta);
        input.value = next;
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "blocks": [
    {
      "type": "meta",
      "name": "Accordion (meta)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Materials, care, and the studio behind each piece.</p>" }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}
