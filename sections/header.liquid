{%- liquid
  assign menu = linklists[section.settings.menu]
  assign sticky = section.settings.sticky | default: settings.sticky_header
  assign transparent = section.settings.transparent | default: settings.header_transparent_on_top
  assign header_class = 'site-header'
  if sticky
    assign header_class = header_class | append: ' site-header--sticky'
  endif
  if transparent and template.name == 'index'
    assign header_class = header_class | append: ' site-header--transparent'
  endif
-%}

<header class="{{ header_class }}" data-site-header role="banner">
  <div class="container site-header__inner">
    <button type="button" class="hamburger" data-mobile-menu-trigger aria-label="{{ 'general.header.open_menu' | t }}">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
      {%- if settings.use_wordmark or settings.logo == blank -%}
        <span class="wordmark">
          <span class="wordmark__iro">IRO</span><span class="wordmark__fit">fit</span>
        </span>
      {%- else -%}
        <img src="{{ settings.logo | image_url: width: 300 }}"
             width="{{ settings.logo_width }}"
             height="auto"
             alt="{{ shop.name | escape }}"
             loading="eager">
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {%- if menu != blank -%}
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <div class="site-header__nav-item" data-megamenu>
              <a href="{{ link.url }}" aria-haspopup="true" aria-expanded="false">{{ link.title }}</a>
              <div class="megamenu" aria-hidden="true">
                <div class="container">
                  <div class="megamenu__grid">
                    {%- for child in link.links -%}
                      <div class="megamenu__col">
                        <h4>{{ child.title }}</h4>
                        {%- if child.links.size > 0 -%}
                          <ul>
                            {%- for sub in child.links -%}
                              <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="site-header__action" aria-label="{{ 'general.search.title' | t }}">
        {{ 'general.search.title' | t }}
      </a>
      <a href="{{ routes.account_url }}" class="site-header__action" aria-label="{{ 'customer.account.title' | t }}">
        {{ 'customer.account.title' | t }}
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__action" data-cart-open aria-label="{{ 'cart.general.title' | t }}">
        {{ 'cart.general.title' | t }}
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<aside class="mobile-menu" data-mobile-menu aria-hidden="true" aria-label="Mobile navigation">
  <div class="mobile-menu__head">
    <span class="wordmark"><span class="wordmark__iro">IRO</span><span class="wordmark__fit">fit</span></span>
    <button type="button" class="link-inline" data-mobile-menu-close aria-label="{{ 'general.header.close_menu' | t }}">
      {{ 'general.header.close' | t }} ×
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    {%- if menu != blank -%}
      {%- for link in menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- endif -%}
  </nav>
  <div style="margin-top:auto;padding-top:2rem;">
    <a href="{{ routes.account_url }}" class="link-inline" style="display:block;margin-bottom:0.75rem;">
      {{ 'customer.account.title' | t }} →
    </a>
    <a href="{{ routes.search_url }}" class="link-inline" style="display:block;">
      {{ 'general.search.title' | t }} →
    </a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Transparent on top of hero (homepage only)",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
