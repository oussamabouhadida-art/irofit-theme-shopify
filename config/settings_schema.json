[
  {
    "name": "theme_info",
    "theme_name": "IROfit",
    "theme_version": "1.0.0",
    "theme_author": "IROfit",
    "theme_documentation_url": "https://irofit.fr",
    "theme_support_url": "mailto:team@irofit.fr"
  },
  {
    "name": "t:settings.brand.header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 200,
        "step": 5,
        "unit": "px",
        "label": "t:settings.brand.logo_width",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "use_wordmark",
        "label": "t:settings.brand.use_wordmark",
        "info": "t:settings.brand.use_wordmark_info",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon"
      }
    ]
  },
  {
    "name": "t:settings.colors.header",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.colors.palette_header"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (warm black)",
        "default": "#1A1612"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream",
        "default": "#F5F0EB"
      },
      {
        "type": "color",
        "id": "color_cream_2",
        "label": "Cream 2",
        "default": "#EFE7DE"
      },
      {
        "type": "color",
        "id": "color_forest",
        "label": "Forest (IRO HER)",
        "default": "#2D4132"
      },
      {
        "type": "color",
        "id": "color_ash",
        "label": "Ash",
        "default": "#807468"
      },
      {
        "type": "color",
        "id": "color_charcoal",
        "label": "Charcoal (IRO HIM)",
        "default": "#3A332C"
      },
      {
        "type": "select",
        "id": "color_scheme_default",
        "label": "t:settings.colors.scheme_default",
        "options": [
          { "value": "dark", "label": "Dark (ink / cream)" },
          { "value": "light", "label": "Light (cream / ink)" }
        ],
        "default": "dark"
      }
    ]
  },
  {
    "name": "t:settings.typography.header",
    "settings": [
      {
        "type": "header",
        "content": "t:settings.typography.display_header"
      },
      {
        "type": "paragraph",
        "content": "EB Garamond (400/500 + italic) is used for all headings, taglines and signatures."
      },
      {
        "type": "header",
        "content": "t:settings.typography.sans_header"
      },
      {
        "type": "paragraph",
        "content": "Inter (300/400/500/600) is used for body, UI, navigation and eyebrow labels."
      },
      {
        "type": "range",
        "id": "type_base_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Base body size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings.layout.header",
    "settings": [
      {
        "type": "range",
        "id": "container_max_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Container max width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "edge_padding_mobile",
        "min": 16,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Edge padding (mobile)",
        "default": 24
      },
      {
        "type": "range",
        "id": "edge_padding_desktop",
        "min": 24,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Edge padding (desktop)",
        "default": 40
      }
    ]
  },
  {
    "name": "t:settings.header_behavior.header",
    "settings": [
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "t:settings.header_behavior.sticky",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_transparent_on_top",
        "label": "t:settings.header_behavior.transparent_on_top",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.social.header",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://instagram.com/iro.fit"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "t:settings.cart.header",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_upsells",
        "label": "Show cart upsells",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_shipping_estimate",
        "label": "Show free shipping bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "€",
        "label": "Free shipping threshold",
        "default": 80
      }
    ]
  },
  {
    "name": "t:settings.product.header",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_badges_enabled",
        "label": "Enable product badges",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "label": "Low stock threshold",
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "product_quick_add",
        "label": "Enable quick add",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.seo.header",
    "settings": [
      {
        "type": "text",
        "id": "organization_name",
        "label": "Organization name (JSON-LD)",
        "default": "IROfit"
      },
      {
        "type": "text",
        "id": "organization_legal_name",
        "label": "Legal name",
        "default": "IROfit"
      },
      {
        "type": "image_picker",
        "id": "organization_logo",
        "label": "Organization logo (JSON-LD)"
      }
    ]
  },
  {
    "name": "t:settings.motion.header",
    "settings": [
      {
        "type": "checkbox",
        "id": "motion_enabled",
        "label": "Enable motion (respects reduced-motion)",
        "default": true
      },
      {
        "type": "range",
        "id": "motion_duration_micro",
        "min": 200,
        "max": 800,
        "step": 50,
        "unit": "ms",
        "label": "Micro duration",
        "default": 500
      },
      {
        "type": "range",
        "id": "motion_duration_hero",
        "min": 500,
        "max": 1200,
        "step": 50,
        "unit": "ms",
        "label": "Hero duration",
        "default": 850
      }
    ]
  }
]
